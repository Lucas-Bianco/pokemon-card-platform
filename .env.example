# Template for .env — copy to .env and fill in real values.
# This file is safe to commit (no secrets). Keep it in sync with .env.
#
# Only CARDPLATFORM_DATA_DIR is required. Every other key is optional: the app
# degrades to an honest "not configured" / empty state when a key is absent —
# never a fabricated value.

# REQUIRED — path to the data directory (SQLite db, FAISS index, card images,
# the 105 real reference scans). Usually an absolute path to ./data.
CARDPLATFORM_DATA_DIR=./data

# OPTIONAL — eBay Finding API key. Powers live Deals, Sealed deals, restock
# alerts, and the paste-a-listing shop assessor. Without it those surfaces show
# an honest "set a listings source key" empty state.
#CARDPLATFORM_LISTINGS_API_KEY=

# OPTIONAL — graded-price reference for the grading-upside surface.
#CARDPLATFORM_GRADED_PRICE_API_KEY=

# OPTIONAL — Web Push (VAPID) keys. Generate with the project's gen-vapid tool.
# Without these the Push channel in More shows "not configured" honestly.
#CARDPLATFORM_VAPID_PUBLIC_KEY=
#CARDPLATFORM_VAPID_PRIVATE_KEY=
#CARDPLATFORM_VAPID_SUBJECT=mailto:you@example.com

# OPTIONAL — Google Sheets sync of sealed purchases (OAuth credentials live in
# secrets/, which is gitignored — never put them in .env).
#CARDPLATFORM_GOOGLE_SHEET_ID=
#CARDPLATFORM_GOOGLE_SHEET_TAB=

# RESERVED — email alert transport. The UI surfaces the hint; the backend SMTP
# wiring is not yet implemented. Uncomment when it lands.
#CARDPLATFORM_SMTP_HOST=
#CARDPLATFORM_SMTP_PORT=
#CARDPLATFORM_SMTP_USER=
#CARDPLATFORM_SMTP_PASSWORD=
#CARDPLATFORM_SMTP_FROM=